config COUNTER_ASR6502
	bool "ASR6502 WDT counter driver"
	default y
	depends on COUNTER
	depends on DT_HAS_ASR_ASR6502_COUNTER_ENABLED
	help
	  Enable the ILO/watchdog-based counter for the ASR6502 (a deep-sleep-capable
	  wake timer). Enabling it disables the watchdog reset function.
