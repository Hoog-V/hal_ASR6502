config WDT_ASR6502
	bool "ASR6502 watchdog driver"
	default y
	depends on WATCHDOG
	depends on DT_HAS_ASR_ASR6502_WATCHDOG_ENABLED
	help
	  Enable the ILO/WDT watchdog for the ASR6502. Shares the WDT hardware with
	  the counter driver; enable only one of them.
